{
  "name": "projects-runner-app",
  "private": true,
  "version": "0.7.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "tauri": "tauri",
    "build": "tsc && vite build",
    "test": "vitest run --dir src",
    "preview": "vite preview",
    "bindings": "cargo run --manifest-path src-tauri/Cargo.toml --bin export_bindings",
    "bindings:check": "node ./scripts/check-bindings-sync.mjs",
    "beui:sync": "node ./scripts/check-beui-sync.mjs",
    "release:check": "node ./scripts/check-version-sync.mjs",
    "release:publish": "node ./scripts/publish-release.mjs",
    "release:build": "tauri build --config src-tauri/tauri.release.conf.json --ci",
    "release:artifacts": "node ./scripts/prepare-release-artifacts.mjs",
    "release:checksums": "node ./scripts/create-release-checksums.mjs",
    "mcp:bridge:build": "node ./scripts/build-mcp-bridge.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@radix-ui/react-avatar": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.16",
    "@radix-ui/react-select": "^2.3.0",
    "@radix-ui/react-slot": "^1.2.5",
    "@tanstack/react-query": "^5.101.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-opener": "^2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "devicon": "^2.17.0",
    "fuse.js": "^7.5.0",
    "lucide-react": "^1.17.0",
    "motion": "^12.42.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.77.0",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.2",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "truncate-middle": "^2.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@tauri-apps/cli": "^2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/truncate-middle": "^1.0.4",
    "@vitejs/plugin-react": "^4.6.0",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.2",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^3.2.7"
  }
}
